@startuml

skinparam classAttributeIconSize 0

' --- Paleta de colores GitHub Dark ---
!$bg = "#0f1117"
!$surface = "#161b22"
!$border = "#30363d"
!$text = "#c9d1d9"
!$keyword_red = "#ff7b72"
!$class_purple = "#d2a8ff"
!$method_blue = "#79c0ff"
!$string_cyan = "#a5d6ff"

' --- Configuración Global ---
skinparam backgroundColor $bg
skinparam defaultFontColor $text
skinparam defaultFontName "Consolas"
skinparam roundcorner 6
skinparam shadowing false
skinparam ArrowFontColor #8899aa

' --- Configuración para Diagramas de Clases ---
skinparam class {
    BackgroundColor $surface
    BorderColor $class_purple
    FontColor $text
    ArrowColor $method_blue
    AttributeFontColor $text
    MethodFontColor $string_cyan
    HeaderBackgroundColor $border
}

hide circle

title Diagrama de clases del sistema de reservas del gimnasio

class Gimnasio {
    + Gimnasio(): void
    + agregarSocio(socio: Socio): void
}

abstract class Plan {
    + Plan(maxClasesPorSemana: int, maxReservasASalaMusculacionPorSemana: int) : void
    + {abstract} verificarMaximoDeReservas(cantidadDeReservas: int): void
    + {abstract} reservarSalaMusculacion(socio: Socio): void
}



class Basico {
    - maxClasesPorSemana: int
    - maxReservasASalaMusculacionPorSemana: int
}

class NoTanBasico {
    - maxClasesPorSemana: int
    - maxReservasASalaMusculacionPorSemana: int
}

class Libre {
}

class FanDeLasClases {
    - maxReservasASalaMusculacionPorSemana: int
}

abstract class Suscripcion {
}

class Mensual extends Suscripcion {
}

class Anual extends Suscripcion {
}

class Precio {
}

class FormaDePago {
}

class Socio {
    - plan: Plan
    + Socio(plan: Plan): void
    + reservarClase(): void
    + reservarSalaMusculacion(): void
}

class AgendaGimnasio {
    + cuantasClasesReservadasEstaSemana(Socio: unSocio): int
    + cuantasVecesReservadasASalaMusculacion(Socio: unSocio): int
}

class LimiteDeReservasAlcanzadoExcepcion{

}

class Error{
}

Plan ....> LimiteDeReservasAlcanzadoExcepcion

Suscripcion o- FormaDePago
Suscripcion o-- Precio

Gimnasio "1" o-- "*" Socio

Socio o-- Plan

Plan *- Suscripcion

AgendaGimnasio <.. Plan

Plan <|-- Basico
Plan <|--- NoTanBasico
Libre -|> Plan
Plan <|--- FanDeLasClases

LimiteDeReservasAlcanzadoExcepcion --|> Error

@enduml